<?xml version="1.0"?>
<!--
  For instructions on using Groot and description of the following BehaviorTree nodes,
  please refer to the groot_instructions.md and REAMDE.md respectively located in the 
  nav2_behavior_tree package.
-->
<root>
  <TreeNodesModel>
    <!-- ############################### ACTION NODES ################################# -->
    <Action ID="PoseRegistration">
      <input_port name="controller_id" default="PoseRegistration"/>
      <input_port name="pose">Pose to registration</input_port>
    </Action>

    <Action ID="SpinToPath">
      <input_port name="path">Planned path</input_port>
      <input_port name="lookahead_distance">Lookahead distance</input_port>
      <input_port name="server_name">Server name</input_port>
      <input_port name="server_timeout">Server timeout</input_port>
    </Action>

    <Action ID="ConcatenatePathsWithArc">
      <input_port name="input_path1">Input Path 1 to cancatenate</input_port>
      <input_port name="input_path2">Input Path 2 to cancatenate</input_port>
      <input_port name="density">Density of arc, should equal to the one in route</input_port>
      <input_port name="arc_radius">Radius of tangent arc</input_port>
      <output_port name="output_path">Paths concatenated</output_port>
    </Action>

    <Action ID="Trigger">
      <input_port name="trigger_topic">Topic of trigger</input_port>
      <input_port name="trigger_type">Type of trigger: empty or bool</input_port>
      <input_port name="trigger_value">Bool value to publish to trigger_topic</input_port>
    </Action>

    <Action ID="SyncTrigger">
      <input_port name="trigger_service">Service name of sync trigger</input_port>
      <input_port name="value">Value of trigger</input_port>
    </Action>

    <Action ID="FollowObjectExt">
      <input_port name="pose_topic">Topic to publish the pose of the object to follow</input_port>
      <input_port name="tracked_frame">Target frame to follow (Optional, used if pose_topic is not set)</input_port>
      <input_port name="max_duration">The maximum duration to follow the object (Optional)</input_port>
      <input_port name="continuous">Following continously changing target or fixed one</input_port>
    </Action>

    <Action ID="CancelFollowObjectExt"/>

    <Action ID="IoRequest">
      <input_port name="io_service">Service name of io request</input_port>
      <input_port name="addr">Address of io port</input_port>
      <input_port name="operation">Operation of IO, 0 for read, 1 for write</input_port>
      <input_port name="value">Value to set to IO port</input_port>
      <output_port name="level">Read value of IO port</output_port>
    </Action>

    <Action ID="ComputeRouteWhi">
      <input_port name="start_id">Node ID to start at</input_port>
      <input_port name="goal_id">Node ID for the goal</input_port>
      <input_port name="start">Start pose of the route if overriding current robot pose and using poses over IDs</input_port>
      <input_port name="goal">Goal pose of the route if using poses over IDs</input_port>
      <input_port name="use_start">Whether to use a fixed start pose or the TF current robot pose</input_port>
      <input_port name="use_poses">Whether to use start/goal poses or startid and goalids on the graph</input_port>
      <output_port name="planning_time">Duration to compute route</output_port>
      <output_port name="path">Path created by ComputeRoute node</output_port>
      <output_port name="route">Route created by ComputeRoute node</output_port>
      <output_port name="error_code_id">"Compute route to pose error code"</output_port>
      <output_port name="error_msg">"Compute route to pose error message"</output_port>
    </Action>

    <!-- ############################### CONDITION NODES ############################## -->
    <Condition ID="IsRobotIdle">
        <input_port name="state_topic">State topic</input_port>
        <input_port name="device_ids">Array of device ids</input_port>
        <input_port name="state_services">Array of state services</input_port>
        <input_port name="battery_state_service">Battery state service</input_port>
    </Condition>

    <Condition ID="IsRobotDocking">
        <input_port name="state_service">State service</input_port>
    </Condition>

    <Condition ID="IsChargingEnough">
        <input_port name="state_service">State service</input_port>
    </Condition>

    <!-- ############################### CONTROL NODES ################################ -->


    <!-- ############################### DECORATOR NODES ############################## -->

  </TreeNodesModel>
</root>
